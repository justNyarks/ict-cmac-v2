DATABASE_URL="postgresql://postgres:local-development-only@127.0.0.1:5432/ict_cmac"
DIRECT_URL="postgresql://postgres:local-development-only@127.0.0.1:5432/ict_cmac"
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"
SERVER_ACTION_ALLOWED_ORIGINS="localhost:3000,127.0.0.1:3000"
# Set true in Vercel Preview ONLY after provisioning its separate database.
PREVIEW_DATABASE_ISOLATED="false"
# Uploads fail closed unless a reachable scanner is configured.
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="30000"
# Use TLS for a remote scanner; set its certificate hostname as needed.
# CLAMAV_TLS="true"
# CLAMAV_SERVER_NAME="scanner.example.com"
# Development seed only; never seed production accounts.
SEED_DEFAULT_PASSWORD="password123"
